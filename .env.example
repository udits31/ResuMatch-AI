# ResuMatch AI — environment variables
# Copy this file to ".env" and fill in your real Supabase connection string.
#
# Where to find it:
#   Supabase dashboard → your project → Settings → Database →
#   "Connection string" → "URI" tab. Use the Session pooler / port 5432 URI.
# Replace [YOUR-PASSWORD] with your database password AND remove the square brackets.
#
# .env is gitignored, so your credentials are never committed.
# Do NOT put real credentials in this .env.example file — it is a template.

SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
